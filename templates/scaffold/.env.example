# SSO 环境：dev | sit | uat | prd
VITE_SSO_ENV=dev

# SSO 区域：domestic（默认）| intl | insure
VITE_SSO_REGION=domestic

# 服务名（默认 za-open-bot，通常不需要改）
VITE_SERVICE_NAME=za-open-bot

# 业务 API base URL（留空则用相对路径）
VITE_API_BASE_URL=

# 开发预览 SSO 旁路：true = 跳过 SSO 认证（仅 .env.local，禁止提交，发布构建不生效）
VITE_SSO_BYPASS=false
