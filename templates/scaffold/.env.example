# SSO 环境：dev | test | pre | prd
# domestic region：dev/test → nsso-test.zhonganinfo.com，pre/prd → nsso.zhonganinfo.com
# 注意：.env.development 默认 dev，.env.production 默认 prd，通常不需要在此覆盖
VITE_SSO_ENV=dev

# SSO 区域：domestic（默认）| intl | insure
VITE_SSO_REGION=domestic

# 服务名（默认 za-open-bot，通常不需要改）
VITE_SERVICE_NAME=za-open-bot

# 业务 API base URL（留空：生产由 window.__BASENAME__ 自动注入，开发由 VITE_DEV_PROXY_* 代理）
VITE_API_BASE_URL=

# React Router basename（留空：生产由 window.__BASENAME__ 自动注入，开发默认 /）
VITE_ROUTER_BASENAME=

# 开发预览 SSO 旁路：true = 跳过 SSO 认证（仅 .env.local，发布构建读 .env.production 不生效）
VITE_SSO_BYPASS=false

# 开发期接口代理（写在 .env.local，dev-preview 启动时自动生成，不进 dist 产物）
# 格式：VITE_DEV_PROXY_<KEY>=<manifest prefix>|<上游 origin>
#   KEY    只允许大写字母、数字、下划线（如 USER、ORDER_V2），禁止连字符
#   prefix 与 manifest.json proxy.routes[].prefix 保持一致，以 / 开头
#   origin 含协议，不含路径，不带尾斜杠（如 https://user-service.example.com）
# 示例：
#   VITE_DEV_PROXY_USER=/user|https://user-service.example.com
#   VITE_DEV_PROXY_ORDER=/order|https://order-service.example.com
#
# 权限校验接口（脚手架内置，保持此条不修改）：
# VITE_DEV_PROXY_OPENAPI=/openapi|http://za-aigc-harness-studio.test.za.biz
